# --- База данных ---
# Порт, на котором база доступна с хоста. Меняй, если 5432 занят системным
# PostgreSQL: значение подставляется и в docker-compose, и в строки подключения.
POSTGRES_PORT=5432

# Пароль владельца схемы. Этой ролью выполняются миграции.
POSTGRES_PASSWORD=change_me_owner

# Пароль роли приложения.
# ВНИМАНИЕ: применяется только при первой инициализации тома с данными.
# Изменение этой строки позже не поменяет пароль в базе — роль сохранит старый,
# и подключение перестанет работать при внешне правильном .env.
# Чтобы сменить пароль, выполни ALTER ROLE вручную либо пересоздай том.
CAIRN_APP_PASSWORD=change_me_app

# ВАЖНО: пароли в строках подключения должны совпадать с двумя переменными выше.
# При их расхождении миграции падают с ошибкой аутентификации.

# Строка подключения для миграций — полные права на схему.
DATABASE_OWNER_URL=postgres://cairn_owner:change_me_owner@localhost:5432/cairn

# Строка подключения приложения — без права изменять журнал.
DATABASE_URL=postgres://cairn_app:change_me_app@localhost:5432/cairn

# --- Приложение ---
# Ключ прикладного шифрования: 32 байта в base64.
# Сгенерировать: openssl rand -base64 32
# Вставлять без кавычек и без переводов строк: приложение сверяет каноничность
# записи и откажется стартовать при лишних символах.
CAIRN_ENCRYPTION_KEY=

# Адрес веб-приложения, используется в ссылках приглашений.
# Значение ниже (порт 3000) верно для локальной разработки без контейнеров:
# `pnpm --filter @cairn/web dev` слушает порт 3000 напрямую.
# При развёртывании через docker-compose приложения сведены реверс-прокси
# на CAIRN_DOMAIN — тогда CAIRN_WEB_URL должен совпадать с ним без порта
# (например, http://localhost или https://cairn.example.com), иначе ссылки
# приглашений укажут на порт, недоступный снаружи контейнера web.
CAIRN_WEB_URL=http://localhost:3000

# Домен, на котором работает система. Для локальной проверки — localhost.
CAIRN_DOMAIN=localhost

# Схема, по которой прокси обслуживает домен.
# http локально: на localhost автоматический HTTPS выпустил бы сертификат
# собственным центром Caddy, и браузер показывал бы ошибку сертификата.
# На боевом домене — https, тогда Caddy получает настоящий сертификат сам.
CAIRN_SCHEME=http

# Порты реверс-прокси. Меняй, если 80 и 443 заняты другим прокси на машине.
# При значении, отличном от 80, порт нужно указать и в CAIRN_WEB_URL —
# иначе ссылки приглашений укажут на недоступный адрес.
CAIRN_HTTP_PORT=80
CAIRN_HTTPS_PORT=443

# Пример для развёрнутой системы:
# CAIRN_DOMAIN=cairn.example.com
# CAIRN_SCHEME=https
# CAIRN_WEB_URL=https://cairn.example.com

# Поддомен соседнего приложения «100 дней до» на этой же машине. Прокси CAIRN
# держит 80 и 443, поэтому сертификат на поддомен получает он и проксирует
# трафик в соседний стек по общей сети hundred-days-edge.
#
# Пусто оставлять не нужно: без значения берётся hundred-days.localhost —
# пустой адрес сайта Caddy принял бы за блок глобальных настроек и упал бы.
# Пока соседа не развернули, блок отвечает 502 и больше ничем себя не
# проявляет.
# HD_NEIGHBOR_SITE=hundred-days.example.com

# Снимает обязательную привязку второго фактора для суперадмина.
# ТОЛЬКО для локальных стендов: на боевом развёртывании флаг недопустим —
# через учётку суперадмина доступны секреты всех проектов.
# CAIRN_ALLOW_INSECURE_NO_TOTP=1

# Уведомления о падении. Без всех трёх переменных выключены целиком.
# Пара генерируется: pnpm --filter @cairn/api cli generate-vapid-keys
CAIRN_VAPID_PUBLIC_KEY=
CAIRN_VAPID_PRIVATE_KEY=
CAIRN_VAPID_SUBJECT=

# --- Автопроверки статуса ---
# Как часто обходить адреса окружений, в минутах. 0 — выключить цикл
# целиком (так работают тесты и локальная разработка): тогда проверки идут
# только кнопкой «Проверить сейчас». Первый прогон всегда идёт при подъёме
# приложения, а не через интервал.
CAIRN_STATUS_CHECK_INTERVAL_MINUTES=15

# Пауза перед переспросом упавшего адреса; 0 — переспросить сразу.
# Инцидент открывается только по подтверждённому отказу, поэтому
# выключателя у переспроса нет — есть лишь длина паузы.
CAIRN_HEALTH_RECHECK_DELAY_SECONDS=30

# Сколько ждать ответа каждой из проверок, в секундах. Мусор и
# неположительное значение означают умолчание, а не «ждать вечно».
CAIRN_HEALTH_CHECK_TIMEOUT_SECONDS=10
CAIRN_TLS_CHECK_TIMEOUT_SECONDS=10
CAIRN_DNS_TIMEOUT_SECONDS=10
CAIRN_RDAP_TIMEOUT_SECONDS=10

# Попыток запроса к DNS. Две, а не одна: DNS ходит по UDP, и потерянный
# пакет читался как «имени нет».
CAIRN_DNS_TRIES=2

# Сколько держать ответ реестра о сроке регистрации, в часах; 0 — не
# кэшировать. Срок меняется раз в год, а прогон идёт каждые четверть часа.
CAIRN_RDAP_CACHE_HOURS=24
