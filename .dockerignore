# Зависимости и артефакты сборки ставятся и собираются внутри образа.
# Без этого исключения COPY затянул бы хостовые node_modules (в pnpm это
# симлинки на локальный store) поверх результата `pnpm install` в слое выше —
# сборка падала бы на битых ссылках.
node_modules
.next
dist
build
coverage
*.tsbuildinfo

# Секреты не должны попадать в слои образа.
.env
.env.*
!.env.example

.git
.claude
docs
*.log
.DS_Store
