# Схема задаётся отдельно от домена: на localhost автоматический HTTPS Caddy
# выпустил бы сертификат собственным центром, и браузер показывал бы ошибку
# сертификата на каждом заходе. Локально нужен простой HTTP; боевой домен
# включает HTTPS значением CAIRN_SCHEME=https — тогда Caddy получает
# сертификат сам.
{$CAIRN_SCHEME:http}://{$CAIRN_DOMAIN:localhost} {
	# API — по префиксу /api, всё остальное отдаёт веб-приложение.
	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}

# Поддомен соседнего приложения «100 дней до». Здесь только маршрутизация:
# этот Caddy держит 80 и 443, и сертификат на поддомен может получить лишь
# он — два сертификата на один порт не живут.
#
# Сосед портов наружу не публикует вовсе и доступен по имени hundred-days в
# общей сети hundred-days-edge (объявлена в docker-compose.yml). Открытый
# порт был бы у него вторым входом в обход TLS.
#
# Имя приходит переменной, как и домен CAIRN: адресов машины в репозитории
# нет. Значение по умолчанию непустое намеренно — пустой адрес сайта Caddy
# принял бы за блок глобальных настроек и упал бы на `handle`.
#
# Пока соседа не развернули, этот блок отвечает 502 и больше ничем себя не
# проявляет: CAIRN от соседа не зависит.
{$HD_NEIGHBOR_SITE:hundred-days.localhost} {
	reverse_proxy hundred-days:80
}
