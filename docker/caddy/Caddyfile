# Схема задаётся отдельно от домена: на localhost автоматический HTTPS Caddy
# выпустил бы сертификат собственным центром, и браузер показывал бы ошибку
# сертификата на каждом заходе. Локально нужен простой HTTP; боевой домен
# включает HTTPS значением CAIRN_SCHEME=https — тогда Caddy получает
# сертификат сам.
{$CAIRN_SCHEME:http}://{$CAIRN_DOMAIN:localhost} {
	# API — по префиксу /api, всё остальное отдаёт веб-приложение.
	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
